#!/usr/bin/env bash
# ftwind - fuzzy-switch tmux windows in a display-popup (needs tmux >= 3.3, fzf >= 0.53)
# Usage in tmux.conf: bind-key f run -b ftwind
# Sorted by most recently visited; needs the session-window-changed hook in tmux.conf
# that stamps @last_visit on each window (unvisited windows sort last, by index).
# Adapted from https://github.com/pokey/dotfiles/blob/dade6c88/bin/ftwind

target=$(
  tmux list-windows -F '#{?@last_visit,#{@last_visit},0}	#{window_index}	#{?window_active,*, }	#{window_name}	#{b:pane_current_path}' |
    sort -t $'\t' -k1,1nr -k2,2n | cut -f2- |
    column -s $'\t' -t |
    fzf --tmux center,60%,40% --reverse --no-multi --ansi \
      --header 'switch window' --bind 'start:pos(0)'
) || exit 0

tmux select-window -t "${target%% *}"
